# =====================================================================
#  الإنتاج: Supabase هو مصدر البيانات الوحيد (راجع DEPLOY.md)
# =====================================================================
# SUPABASE_URL=https://khwhccamagczshddxznd.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...        # الخادم فقط — لا تستخدم NEXT_PUBLIC_
# SUPABASE_PROJECT_REF=khwhccamagczshddxznd
# SUPABASE_REGION=eu-west-1
# SUPABASE_STORAGE_BUCKET=product-images
# REQUIRE_SUPABASE=true                     # يمنع أي رجوع إلى قاعدة محلية

# =====================================================================
#  متغيرات البيئة — تُضبط في إعدادات الاستضافة (Secrets / Environment Variables)
#  لا تضع القيم الحقيقية في هذا الملف ولا في الكود، ولا تستخدم البادئة NEXT_PUBLIC_
# =====================================================================

# --- قاعدة البيانات التي يعمل عليها الموقع (إلزامي) -------------------------
# تطوير محلي:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# الإنتاج على Supabase (Transaction pooler — المنفذ 6543). له الأولوية على DATABASE_URL:
# SUPABASE_DATABASE_URL=postgresql://postgres.khwhccamagczshddxznd:<DB-PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# المشروع المعتمد: khwhccamagczshddxznd — الكود يرفض أي مشروع Supabase آخر.
# SUPABASE_PROJECT_REF=khwhccamagczshddxznd
# SUPABASE_REGION=eu-west-1
# REQUIRE_SUPABASE=true   # في الإنتاج: يرفض التشغيل بدون رابط Supabase صحيح (لا رجوع صامت لقاعدة محلية)
# ملاحظة: الرابط المباشر db.<PROJECT-REF>.supabase.co يعمل عبر IPv6 فقط ولا يعمل على أغلب الاستضافات.

# --- نقل البيانات (scripts/migrate-to-supabase.ts) — Session pooler، المنفذ 5432 ---
# TARGET_DATABASE_URL=postgresql://postgres.khwhccamagczshddxznd:<DB-PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- اختياري: أمان واتصال --------------------------------------------------
# شهادة Supabase (PEM) للتحقق الكامل من هوية الخادم. بدونها يكون الاتصال مشفّراً دون التحقق من الجهة المصدرة.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL=          # disable | require | verify  (الافتراضي تلقائي: بدون SSL محلياً، مع SSL لأي قاعدة بعيدة)
# DATABASE_POOL_MAX=     # الافتراضي 3 لقاعدة بعيدة، ويُفضّل 1 على Vercel

# --- التهيئة التلقائية للجداول والبيانات الأولية ---------------------------
# الافتراضي: مفعّلة للقاعدة المحلية فقط، ومتوقفة تلقائياً لأي قاعدة بعيدة (Supabase)
# حتى لا تُضاف بيانات افتراضية إلى قاعدة الإنتاج. لا تفعّلها على قاعدة تحتوي بيانات حقيقية.
# DB_AUTO_SETUP=0

# اختياري: ضع 1 لإضافة طلبات تجريبية عند التهيئة الأولى (للتطوير فقط)
SEED_SAMPLE_ORDERS=0

# --- لوحة الإدارة (إلزامي في الإنتاج) -----------------------------------------
# بدون ADMIN_PASSWORD يكون دخول الإدارة معطّلاً على أي قاعدة بعيدة (لا كلمة مرور افتراضية في الإنتاج).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=   # نص عشوائي 32+ حرفاً لتوقيع الجلسات (موصى به)

# ملاحظة: المشروع لا يستخدم مكتبة Supabase حالياً، فلا حاجة إلى
# SUPABASE_URL أو Publishable Key أو Secret Key. لا تضف الـ Secret Key إلى أي ملف.
